# 部署选项可通过 Docker Compose 或 Node 进程环境传入。
# PORT=4188
# HOST=0.0.0.0

# 手机访问服务器时使用的地址。例如反代地址或可达的局域网地址。
# POLYPHONY_PUBLIC_ORIGIN=http://192.168.1.100:4188
# POLYPHONY_SECURE_COOKIES=1
# POLYPHONY_TEACHER_PASSPHRASE=

# 直接运行 Node 默认用 JSON。Docker Compose 默认使用 /data/rooms.sqlite。
# 选择已有课堂对应的文件。切换引擎时使用另一文件并保留原快照。
# POLYPHONY_STORAGE=sqlite
# POLYPHONY_ROOM_FILE=/data/rooms.sqlite

# Chat Completions 编排主模型。密钥在教师设置的当前会话填写，或由进程环境传入。
# POLYPHONY_AI_BASE_URL=
# POLYPHONY_AI_MODEL=
# POLYPHONY_AI_KEY=
# POLYPHONY_AI_OUTPUT_MODE=json_object

# Chat Completions 快速决策模型。
# POLYPHONY_FAST_AI_BASE_URL=
# POLYPHONY_FAST_AI_MODEL=
# POLYPHONY_FAST_AI_KEY=
# POLYPHONY_FAST_AI_OUTPUT_MODE=json_object

