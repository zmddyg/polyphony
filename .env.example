# Polyphony (共演) Server Configuration Template
# Copy to `.env` (or export in your shell / docker-compose environment) and adjust as needed.
# Never commit real API keys or passphrases to version control.

# --- Network & Server ---
HOST=0.0.0.0
PORT=4188
# Public origin embedded in student QR codes & mobile remote pairing links (useful on multi-NIC LANs or behind reverse proxies)
# POLYPHONY_PUBLIC_ORIGIN=http://192.168.1.100:4188
# Trust X-Forwarded-For header when deployed behind Nginx/Caddy/Cloudflare (1 = trust)
# POLYPHONY_TRUST_PROXY=0

# --- Storage & Retention ---
# Default single-file JSON snapshot; switch to a `.db` / `.sqlite` path or set POLYPHONY_STORAGE=sqlite to use Node 22+ native SQLite WAL
POLYPHONY_ROOM_FILE=.polyphony-rooms.json
# POLYPHONY_STORAGE=sqlite
# Auto-prune inactive rooms older than N hours (default: 72, set 0 to disable)
POLYPHONY_ROOM_TTL_HOURS=72

# --- Classroom Security & Capacity ---
# Optional teacher passphrase required when creating rooms or importing materials on a public server
# POLYPHONY_TEACHER_PASSPHRASE=
# Set 0 to disable per-IP sliding-window rate limiting (enabled by default)
# POLYPHONY_RATE_LIMIT=1
# Max SSE connections per room / globally (defaults: 500 / 2000)
# POLYPHONY_MAX_ROOM_SSE=500
# POLYPHONY_MAX_TOTAL_SSE=2000

# --- AI Lesson Composition, Planning & Classroom Analysis (OpenAI-compatible Chat Completions) ---
# POLYPHONY_AI_BASE_URL=https://api.openai.com/v1
# POLYPHONY_AI_MODEL=gpt-4o-mini
# POLYPHONY_AI_KEY=
# Output mode: json_object (default), json_schema, or text
# POLYPHONY_AI_OUTPUT_MODE=json_object
# Optional sampling temperature (omit to use provider default, recommended for reasoning models)
# POLYPHONY_AI_TEMPERATURE=
# Timeouts in milliseconds
# POLYPHONY_AI_TIMEOUT_MS=18000
# POLYPHONY_AI_PLAN_TIMEOUT_MS=25000
# POLYPHONY_AI_ANALYSIS_TIMEOUT_MS=6500
# POLYPHONY_AI_PEER_TIMEOUT_MS=8000
# Set 1 to log sanitized AI adapter diagnostics on stderr
# POLYPHONY_AI_DEBUG=0

# --- Optional Fast Page-Level Planner (TypeSafe System One / Jev) ---
# POLYPHONY_JEV_KEY=
# POLYPHONY_JEV_MODEL=jev-latest
# POLYPHONY_JEV_TIMEOUT_MS=8000

# --- Optional Document Rendering (LibreOffice UNO + PyMuPDF) ---
# POLYPHONY_SOFFICE=soffice
# POLYPHONY_LIBREOFFICE_PYTHON=python3
# POLYPHONY_PDF_PYTHON=python3
