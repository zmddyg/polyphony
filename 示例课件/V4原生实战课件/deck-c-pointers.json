        "}",
        "inv · 双指针向中点收缩",
        "void inv(int x[], int n) {",
        "if (n <= 1) return;",
        "int *i=x, *j=x+n-1;",
        "int *p=x+(n-1)/2;",
        "for (; i<=p && i<j; ++i,--j) {",
        "int temp=*i;",
        "*i=*j;",
        "*j=temp;",
        "}",
        "}",
        "输出与循环不变量",
